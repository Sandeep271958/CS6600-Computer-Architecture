PIPEISA 1
ENTRY 0x00000000

# PC 0 and PC 0x02000000 have the same 9-bit BTB index and 14-bit BTB tag.
# The first jump trains the entry; the high-address ADDI must survive the
# resulting false branch identification.
INST 0x00000000 J 0 0 0 0x00000004
INST 0x00000004 J 0 0 0 0x02000000
INST 0x00000008 ADDI 0 0 0 0
INST 0x0000000c ADDI 0 0 0 0
INST 0x00000010 ADDI 0 0 0 0
INST 0x00000014 ADDI 0 0 0 0
INST 0x00000018 ADDI 0 0 0 0
INST 0x0000001c ADDI 0 0 0 0
INST 0x02000000 ADDI 1 0 0 42
INST 0x02000004 HALT 0 0 0 0
INST 0x02000008 ADDI 0 0 0 0
INST 0x0200000c ADDI 0 0 0 0
INST 0x02000010 ADDI 0 0 0 0
INST 0x02000014 ADDI 0 0 0 0
INST 0x02000018 ADDI 0 0 0 0
INST 0x0200001c ADDI 0 0 0 0

END
